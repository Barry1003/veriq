    },
    "timeouts": {
      "minimum": 0,
      "title": "Timeouts",
      "type": "integer"
    },
    "window_seconds": {
      "default": 300,
      "maximum": 3600,
      "minimum": 1,
      "title": "Window Seconds",
      "type": "integer"
    }
  },
  "required": [
    "route_id",
    "gateway_id",
    "attempts",
    "timeouts"
