{
  "$defs": {
    "ToolArguments": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_.:-]{1,180}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "native_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Id"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "at": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        }
      },
      "title": "ToolArguments",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "get_transaction_evidence",
            "get_operational_observations",
            "get_institutional_context",
            "get_customer_issue_context",
            "search_institutional_sources"
          ],
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "$ref": "#/$defs/ToolArguments"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "tool",
        "assess",
        "inconclusive"
      ],
      "title": "Action",
      "type": "string"
    },
    "question": {
      "maxLength": 250,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "tool_call": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolCall"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "action",
    "question"
  ],
  "title": "InvestigativeChoice",
  "type": "object"
}
