      }
    },
    "/v1/institutional/configurations": {
      "get": {
        "summary": "List Configurations",
        "operationId": "list_configurations_v1_institutional_configurations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RowView"
                  },
                  "type": "array",
                  "title": "Response List Configurations V1 Institutional Configurations Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "summary": "Configurations",
        "operationId": "configurations_v1_institutional_configurations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Knowledge"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RowView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/feed": {
      "get": {
        "summary": "Feed",
        "operationId": "feed_v1_feed_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "source_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Source Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "After"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Condition": {
        "properties": {
          "gateway_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "title": "Gateway Id"
          },
          "timeout": {
            "type": "boolean",
            "title": "Timeout"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "gateway_id",
          "timeout"
        ],
        "title": "Condition"
      },
      "EntityClaim": {
        "properties": {
          "native_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "title": "Native Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "route",
              "gateway",
              "service",
              "system",
              "process",
              "procedure"
            ],
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Aliases"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "native_id",
          "kind",
          "name"
        ],
        "title": "EntityClaim"
      },
      "FeedItem": {
        "properties": {
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "envelope": {
            "additionalProperties": true,
            "type": "object",
            "title": "Envelope"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence",
          "envelope"
        ],
        "title": "FeedItem"
      },
      "FeedPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "type": "integer",
            "title": "Next Cursor"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "FeedPage"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "application": {
            "type": "string",
            "title": "Application"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "application",
          "status"
        ],
        "title": "Health"
      },
      "Interaction": {
        "properties": {
          "occurred_at": {
            "type": "string",
            "title": "Occurred At"
          },
          "channel": {
            "type": "string",
            "enum": [
              "in_app",
              "email",
              "contact_centre",
              "branch"
            ],
            "title": "Channel"
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text"
          },
          "customer_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "title": "Customer Id"
          },
          "transaction_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.:-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "channel",
          "text",
          "customer_id"
        ],
        "title": "Interaction"
      },
      "Knowledge": {
        "properties": {
          "entities": {
            "items": {
              "$ref": "#/components/schemas/EntityClaim"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Entities"
          },
          "relationships": {
            "items": {
              "$ref": "#/components/schemas/RelationshipClaim"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Relationships"
          },
          "valid_from": {
            "type": "string",
            "title": "Valid From"
          },
          "valid_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "entities",
          "relationships",
          "valid_from"
        ],
        "title": "Knowledge"
      },
      "Reconciliation": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ],
            "title": "Outcome"
          },
          "beneficiary_verified": {
            "type": "boolean",
            "title": "Beneficiary Verified",
            "default": false
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Rationale"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome",
          "rationale"
        ],
        "title": "Reconciliation"
      },
      "RelationshipClaim": {
        "properties": {
          "subject": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "title": "Subject"
          },
          "predicate": {
            "type": "string",
            "enum": [
              "uses_gateway",
              "depends_on",
              "belongs_to",
              "governed_by"
            ],
            "title": "Predicate"
          },
          "object": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "title": "Object"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subject",
          "predicate",
          "object"
        ],
        "title": "RelationshipClaim"
      },
      "RowView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "classification": {
            "type": "string",
            "enum": [
              "internal",
              "restricted"
            ],
            "title": "Classification"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "classification",
          "created_at",
          "data"
        ],
        "title": "RowView"
      },
      "TransferRequest": {
        "properties": {
          "account_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "title": "Account Id"
          },
          "amount_minor": {
            "type": "integer",
            "maximum": 10000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor"
          },
          "route_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "title": "Route Id"
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "account_id",
          "amount_minor",
          "route_id",
          "idempotency_key"
        ],
        "title": "TransferRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
