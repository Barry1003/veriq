VERIQ_DATA_SOURCE=mock
# Synthetic localhost deployment only. scripts.configure_frontends provisions private values.
DEMO_AUTH_ENABLED=false
VERIQ_API_URL=http://127.0.0.1:8610
VERIQ_UI_ORIGIN=http://localhost:3001
# Random secret of at least 32 characters.
VERIQ_SESSION_SECRET=
# Distinct browser accounts. Passwords must be at least 12 characters.
VERIQ_ADMIN_USERNAME=
VERIQ_ADMIN_PASSWORD=
VERIQ_INVESTIGATOR_USERNAME=
VERIQ_INVESTIGATOR_PASSWORD=
# Never use NEXT_PUBLIC_* variables for these values.
VERIQ_ADMIN_TOKEN=
VERIQ_INVESTIGATOR_TOKEN=
