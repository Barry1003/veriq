# Synthetic localhost deployment only. Build and start with the same data mode.
CEDAR_DATA_SOURCE=preview
# scripts.configure_frontends provisions these server-only settings from a named rehearsal.
DEMO_AUTH_ENABLED=false
CEDAR_API_URL=http://127.0.0.1:8611
CEDAR_UI_ORIGIN=http://localhost:3000
# Random secrets, each at least 32 characters. Retain the recovery secret across restarts.
CEDAR_SESSION_SECRET=
CEDAR_REQUEST_COOKIE_SECRET=
# Separate usernames; passwords must be at least 12 characters.
CEDAR_CUSTOMER_USERNAME=
CEDAR_CUSTOMER_PASSWORD=
CEDAR_STAFF_USERNAME=
CEDAR_STAFF_PASSWORD=
CEDAR_OPERATOR_USERNAME=
CEDAR_OPERATOR_PASSWORD=
# Application credentials never enter browser forms or NEXT_PUBLIC_* settings.
CEDAR_CUSTOMER_TOKEN=
CEDAR_STAFF_TOKEN=
CEDAR_FEED_TOKEN=
CEDAR_CHANNEL_TOKEN=
CEDAR_SIMULATOR_TOKEN=
# Private persistent recovery directory; defaults to ignored .cedar-demo/.
CEDAR_REQUEST_STORE=
