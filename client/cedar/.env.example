# Preview never creates bank records. Build and start with the same data mode.
CEDAR_DATA_SOURCE=preview
# Server only. Obtain separate scoped credentials from the deployment administrator.
CEDAR_API_URL=http://127.0.0.1:8611
# Exact public browser origin; also used behind a reverse proxy.
CEDAR_UI_ORIGIN=http://localhost:3000
CEDAR_CUSTOMER_TOKEN=
CEDAR_STAFF_TOKEN=
CEDAR_FEED_TOKEN=
CEDAR_CHANNEL_TOKEN=
CEDAR_SIMULATOR_TOKEN=
# Existing restricted synthetic-demo gate; this is not per-user authorization.
CEDAR_UI_USERNAME=
CEDAR_UI_PASSWORD=
CEDAR_CUSTOMER_ACTION_KEY=
CEDAR_OPERATOR_KEY=
# A persistent, random secret of at least 32 characters, separate from API credentials.
# Retain it across restarts so uncertain transfer requests can be recovered.
CEDAR_REQUEST_COOKIE_SECRET=
